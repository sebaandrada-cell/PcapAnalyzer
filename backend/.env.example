# PcapAnalyzer — configuración local del backend.
# Copia este archivo a `.env` (mismo directorio) y rellena lo que necesites.
# `.env` está en .gitignore: nunca se versiona.

# Clave de la API de Anthropic para la capa IA (diagnóstico y consultas NL).
# Consíguela en https://platform.claude.com/ → API keys.
ANTHROPIC_API_KEY=

# API Bearer tokens, comma-separated. Required for analysis, jobs, reports, and AI.
# Use one high-entropy token per trusted client; never commit real tokens.
# Generate with: openssl rand -hex 32
API_TOKENS=
# Per-token quotas: 30 charged API requests/minute and 2 concurrent analyses.
# The in-process async queue accepts at most 4 waiting jobs across all tokens.
#API_MAX_REQUESTS_PER_MINUTE=30
#API_MAX_JOBS_PER_TOKEN=2
#MAX_QUEUED_JOBS=4
#MAX_PENDING_CAPTURE_BYTES=1073741824
#MAX_RETAINED_JOBS=20

# Modelo a usar (por defecto claude-opus-4-8).
#LLM_MODEL=claude-opus-4-8

# Modo demo: respuestas de IA simuladas sin llamar a la API (sin coste,
# sin credenciales). Útil para probar la interfaz. Pon 1 para activarlo.
#LLM_DEMO=1

# Supabase multi-tenant mode: Auth JWTs, shared Postgres quotas/jobs, and
# private Storage for capture files. Apply supabase/migrations first.
#AUTH_MODE=supabase
#SUPABASE_URL=https://<project-ref>.supabase.co
#SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=
#SUPABASE_DB_URL=postgresql://...?...sslmode=require
#SUPABASE_JWT_SECRET=
#SUPABASE_STORAGE_BUCKET=pcap-captures
