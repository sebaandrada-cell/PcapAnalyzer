# Docker Compose runtime configuration. Copy to .env and keep real keys private.
# Easiest: run ./start.sh — it creates .env and fills API_TOKENS for you.
AUTH_MODE=token
# Access token for the web UI. Leave empty and ./start.sh generates a random
# one. If you set it by hand, use 32+ random characters (openssl rand -hex 32).
API_TOKENS=

# Supabase mode: Auth, Postgres, and private Storage.
# Set AUTH_MODE=supabase and fill every value before enabling the worker profile.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Only required for older projects still signing access tokens with HS256.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=pcap-captures

# AI diagnosis. Without a key the app runs in demo mode: the diagnosis is
# simulated from the analysis itself (marked "(modo demo)"), at no cost.
# For the real model: paste your key below AND set LLM_DEMO=0 (demo mode wins
# over a real key while LLM_DEMO=1).
LLM_DEMO=1
ANTHROPIC_API_KEY=
PCAPANALYZER_PORT=8080
