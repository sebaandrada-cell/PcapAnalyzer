# For local Vite development with Supabase Auth. The anon key is public and
# protected by Supabase RLS; never put a service-role key in frontend config.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site key of the Cloudflare Turnstile widget used by the contact form (it is not secret).
# The secret key and the mail settings live only in Vercel (see DEPLOYMENT.md), never here.
VITE_TURNSTILE_SITE_KEY=

# Set to 1 to show "Continue with Google" (enable the Google provider in Supabase first).
VITE_GOOGLE_LOGIN=
