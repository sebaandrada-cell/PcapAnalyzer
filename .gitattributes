# Files that live in the repository but must NOT ship in the customer download.
# scripts/build-release.sh builds the bundle with `git archive`, which honors
# export-ignore, and then verifies the result.

# Marketing / internal planning
PLAN-DIFUSION.md  export-ignore
landing.html      export-ignore

# Our own hosted beta (names our infrastructure) and agent tooling
render.yaml       export-ignore
CLAUDE.md         export-ignore
.claude           export-ignore

# Build tooling and this file
scripts           export-ignore
.gitattributes    export-ignore

# CI workflows are repo infrastructure, not part of the product.
.github           export-ignore

# Public demo data (hosted build only); the self-hosted download does not use it.
frontend/public/demo  export-ignore

# Contact form function of our hosted beta (Vercel + Resend + Turnstile); names our domains.
frontend/api  export-ignore

# Marketing screenshots, not part of the product.
marketing  export-ignore

# Internal design docs (not part of the product)
docs/superpowers export-ignore
